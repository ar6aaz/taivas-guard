# Copy to .env. Every setting is listed in ific_guard/config.py.
IFIC_API_KEY=change-me                    # required for write endpoints; openssl rand -hex 32
IFIC_DATABASE_URL=sqlite:///data/ops.db   # compose overrides this with Postgres
IFIC_MIN_ISSUE=3074                       # oldest issue to download; each space zip is 20-60 MB
IFIC_SYNC_CRON="0 */6 * * *"              # when to check ITU, in UTC; standard cron syntax

# Email. console logs the message, file writes data/outbox/*.eml, smtp sends it for real.
IFIC_EMAIL_BACKEND=console
IFIC_MAIL_FROM=ific-guard@example.org
IFIC_MAIL_TO=["spectrum-expert@example.org"]
IFIC_OPS_MAIL_TO=["ops@example.org"]
IFIC_NOTIFY_MIN_SEVERITY=medium
IFIC_PUBLIC_BASE_URL=http://localhost:8002
# IFIC_SMTP_HOST=smtp.example.org
# IFIC_SMTP_PORT=587
# IFIC_SMTP_USER=
# IFIC_SMTP_PASSWORD=

# Optional. Without a key, GET /cases/{id}/draft returns the deterministic template.
# ANTHROPIC_API_KEY=
# IFIC_LLM_MODEL=claude-opus-5-5
